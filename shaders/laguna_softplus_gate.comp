#version 450

// Laguna per-head scalar softplus ATTENTION GATE (PIECE 3 of the GPU-resident
// span fold). Replaces the host softplus loop in `LagunaGpuModel::attn_cached_1cb`:
// computes the per-head gate `softplus(g[h])` and broadcast-multiplies it into
// the attention output over `head_dim`, IN PLACE, before o_proj.
//
//   softplus(x) = ln(1 + e^x)
// evaluated in the numerically-stable form used by the CPU oracle
// (`laguna::softplus` / `laguna_gpu::softplus`:
//   x.max(0.0) + (-x.abs()).exp().ln_1p()  ==  max(x,0) + log(1 + e^-|x|)),
// which collapses to `x` for large positive x and to `e^x` for large negative x,
// so it never overflows. GLSL has no log1p, so the small-t tail is a series (see
// main). The GPU result differs from the host libm result only in the last ulps
// of exp/log, including in the far negative tail.
//
// Dispatch ((nq*hd + 255)/256, 1, 1).
//   binding 0 = g[nq]      (gate projection g_proj(h), read-only)
//   binding 1 = attn[nq*hd] (attention output, scaled in place)

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Parameters {
    uint nq;   // number of query heads (48 full / 72 sliding)
    uint hd;   // head_dim (128)
};

layout(binding = 0) readonly buffer GBuf { float g[]; };    // [nq]
layout(binding = 1) buffer ABuf { float attn[]; };          // [nq*hd] in/out

void main() {
    const uint idx = gl_GlobalInvocationID.x;
    const uint total = nq * hd;
    if (idx >= total) {
        return;
    }
    const uint h = idx / hd;                 // head index for this element
    const float x = g[h];
    // log1p(t) for t = e^-|x| in (0, 1]. `log(1.0 + t)` alone is NOT enough in
    // f32: once t < 2^-24 (x < ~-16.6), 1.0 + t rounds to exactly 1.0 and the gate
    // becomes 0 where the host returns e^x (PR #94 review: x = -20 gave 0 vs
    // 2.06e-9, zeroing a head). For small t it is also inaccurate: the rounding
    // of 1 + t and the GPU log's ~2^-21 absolute error near 1 are large RELATIVE
    // to t. So below t = 2^-5 use the series t - t^2/2 + t^3/3 - t^4/4 (Horner);
    // its truncation error is under t^4/5 <= 2e-7 relative. Above, log(1 + t) is
    // >= 0.03 and its error is <= ~5e-5 relative.
    const float t = exp(-abs(x));
    const float l1p = (t < 0.03125)
        ? t * (1.0 - t * (0.5 - t * (0.33333334 - 0.25 * t)))
        : log(1.0 + t);
    const float sp = max(x, 0.0) + l1p;
    attn[idx] *= sp;
}
