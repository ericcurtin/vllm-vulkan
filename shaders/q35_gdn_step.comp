#version 450

// Qwen3.6 GatedDeltaNet decode-step delta-rule recurrence + gated RMSNorm
// (WS1b). One workgroup per value-head `j` (dispatch (nv,1,1)); one thread per
// value column `vv` (vd <= 128). The state matrix `[nv, kd, vd]` stays
// GTT-resident between tokens.
//
// Ports the per-head closure of `Qwen35Model::delta_net` with the SAME
// per-column f32 accumulation order over kk (columns are independent, so
// thread-parallelism over vv is exact):
//   g     = -exp(A_log[j]) * softplus(a[j] + dt_bias[j])
//   decay = exp(g); beta = sigmoid(b[j])
//   state[j] *= decay;   kv_mem = state^T . k    (fused: same values/order)
//   delta = (v - kv_mem) * beta
//   state += k (x) delta; out = state . q        (fused: same values/order)
//   gated = rmsnorm(out, norm_w) * silu(z)
// The RMSNorm sum-of-squares is computed sequentially by thread 0 (bit-exact
// order vs model::cpu_rms_norm). exp/log/sigmoid use GPU intrinsics (last-ulp
// vs libm — the documented cos>=0.99999 tolerance).
//
// params[] packs the per-layer constants: [A_log(nv) | dt_bias(nv) | norm_w(vd)].

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Parameters {
    uint kd;
    uint vd;
    uint ratio;   // nv / nk (repeat_interleave: v-head j uses k-head j/ratio)
    uint v_off;   // v_flat offset into conv_out (= 2*key_dim)
    float eps;
    uint nv;
};

layout(binding = 0) readonly buffer QBuf { float q_in[]; };      // [key_dim] normed
layout(binding = 1) readonly buffer KBuf { float k_in[]; };      // [key_dim] normed
layout(binding = 2) readonly buffer CBuf { float conv_out[]; };  // v at v_off
layout(binding = 3) readonly buffer ABuf { float a_in[]; };      // [nv]
layout(binding = 4) readonly buffer BBuf { float b_in[]; };      // [nv]
layout(binding = 5) readonly buffer ZBuf { float z_in[]; };      // [value_dim]
layout(binding = 6) readonly buffer PBuf { float params[]; };    // [2*nv + vd]
layout(binding = 7) buffer SBuf { float state[]; };              // [nv, kd, vd]
layout(binding = 8) writeonly buffer GBuf { float gated[]; };    // [value_dim]

shared float sh_out[128];
shared float sh_scale;

void main() {
    const uint j = gl_WorkGroupID.x;
    const uint vv = gl_LocalInvocationID.x;
    const uint kh = j / ratio;

    // Per-head scalars (uniform across the workgroup; recomputed per thread).
    const float xx = a_in[j] + params[nv + j];
    const float sp = (xx > 20.0) ? xx : log(1.0 + exp(xx)); // softplus
    const float g = -exp(params[j]) * sp;
    const float decay = exp(g);
    const float beta = 1.0 / (1.0 + exp(-b_in[j]));

    const uint sb = j * kd * vd;
    float outv = 0.0;
    if (vv < vd) {
        // Pass 1: state *= decay fused with kv_mem = state^T . k (kk order
        // matches the CPU loops; the decayed value written back is the value
        // accumulated, exactly as the CPU's two passes observe it).
        float kv_mem = 0.0;
        for (uint kk = 0u; kk < kd; kk++) {
            const float s = state[sb + kk * vd + vv] * decay;
            state[sb + kk * vd + vv] = s;
            kv_mem += s * k_in[kh * kd + kk];
        }
        const float delta = (conv_out[v_off + j * vd + vv] - kv_mem) * beta;
        // Pass 2: state += k (x) delta fused with out = state . q.
        float o = 0.0;
        for (uint kk = 0u; kk < kd; kk++) {
            const float s = state[sb + kk * vd + vv] + k_in[kh * kd + kk] * delta;
            state[sb + kk * vd + vv] = s;
            o += s * q_in[kh * kd + kk];
        }
        outv = o;
        sh_out[vv] = o;
    }
    barrier();
    if (vv == 0u) {
        float ss = 0.0;
        for (uint i = 0u; i < vd; i++) {
            const float v = sh_out[i];
            ss += v * v;
        }
        sh_scale = 1.0 / sqrt(ss / float(vd) + eps);
    }
    barrier();
    if (vv < vd) {
        const float normed = outv * sh_scale * params[2u * nv + vv];
        const float zz = z_in[j * vd + vv];
        gated[j * vd + vv] = normed * (zz / (1.0 + exp(-zz))); // * silu(z)
    }
}
