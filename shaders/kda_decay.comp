#version 450

// Kimi Delta Attention (KDA) per-channel decay precompute (decode lever #5).
//
// Moves the host decay glue in `kimi::kda::decode_step` / `kda_step_resident`
//   decay[h*kd+dk] = exp(-exp(A_log[h]) * softplus(a_log_in[h*kd+dk] + dt_bias[h*kd+dk]))
// into the fused KDA command buffer, so the projections -> conv -> qknorm ->
// DECAY -> kda_gdn_step -> o_proj chain records into ONE submit with no host
// round-trip. One thread per key-channel `i` of nh*kd (== proj == key_dim).
//
// Accumulation is trivial (elementwise) so the ONLY divergence vs the CPU
// reference is the last-ulp of the GPU exp()/log() intrinsics vs libm — the
// documented KimiGpuStage cos>=0.99999 / argmax-exact decode tolerance. The
// stable softplus mirrors the CPU `kda::softplus`:
//   softplus(x) = log1p(exp(-|x|)) + max(x, 0).

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Parameters {
    uint nh;   // number of key heads (KDA: 32)
    uint kd;   // key head dim       (KDA: 128)
};

layout(binding = 0) readonly buffer AlogInBuf { float a_log_in[]; }; // [nh*kd] = f_b(f_a(x))
layout(binding = 1) readonly buffer DtBiasBuf { float dt_bias[]; };  // [nh*kd]
layout(binding = 2) readonly buffer AlogBuf   { float a_log[]; };    // [nh] (per-head)
layout(binding = 3) writeonly buffer OutBuf   { float decay[]; };    // [nh*kd]

void main() {
    const uint i = gl_GlobalInvocationID.x;
    const uint total = nh * kd;
    if (i >= total) {
        return;
    }
    const uint h = i / kd;
    const float al = a_log_in[i] + dt_bias[i];
    // stable softplus: log1p(exp(-|al|)) + max(al, 0)
    const float sp = log(1.0 + exp(-abs(al))) + max(al, 0.0);
    const float neg_exp_a = -exp(a_log[h]);
    decay[i] = exp(neg_exp_a * sp);
}
