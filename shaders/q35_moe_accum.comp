#version 450

// Qwen3.6 MoE tail: score-weighted routed-expert accumulate + sigmoid-gated
// shared-expert add + the MLP residual add, in ONE dispatch (WS3).
//
// Replaces the host tail of `qwen35_moe_mlp_gpu_resident` so the fused MoE
// command buffer can produce the NEXT layer's hidden state entirely on-GPU
// (no readback), enabling the pipelined CB ring. Math matches the host loop
// EXACTLY (same accumulation order):
//   acc  = sum_{slot 0..7} score[slot] * down[slot][i]     (slot order)
//   acc += sigmoid(shared_gate_logit) * shared_out[i]
//   out[i] = h1[i] + acc                                    (residual last)
// The only non-bit-exact op vs libm is exp() in the sigmoid (last ulp).
//
// Fixed top_k = 8 (the 35B-A3B config); the Rust side falls back to the host
// tail when top_k != 8.

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Parameters {
    uint n;      // hidden size
    float s0; float s1; float s2; float s3;
    float s4; float s5; float s6; float s7;   // routed-expert scores, slot order
};

layout(binding = 0)  readonly buffer D0 { float d0[]; };   // [n] expert slot 0 down
layout(binding = 1)  readonly buffer D1 { float d1[]; };
layout(binding = 2)  readonly buffer D2 { float d2[]; };
layout(binding = 3)  readonly buffer D3 { float d3[]; };
layout(binding = 4)  readonly buffer D4 { float d4[]; };
layout(binding = 5)  readonly buffer D5 { float d5[]; };
layout(binding = 6)  readonly buffer D6 { float d6[]; };
layout(binding = 7)  readonly buffer D7 { float d7[]; };
layout(binding = 8)  readonly buffer SH { float sh[]; };   // [n] shared-expert down
layout(binding = 9)  readonly buffer SL { float lg[]; };   // [1] shared-gate logit
layout(binding = 10) readonly buffer H1 { float h1[]; };   // [n] post-attn residual
layout(binding = 11) writeonly buffer OUTB { float outb[]; }; // [n] next hidden

void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i >= n) {
        return;
    }
    float acc = s0 * d0[i];
    acc += s1 * d1[i];
    acc += s2 * d2[i];
    acc += s3 * d3[i];
    acc += s4 * d4[i];
    acc += s5 * d5[i];
    acc += s6 * d6[i];
    acc += s7 * d7[i];
    acc += (1.0 / (1.0 + exp(-lg[0]))) * sh[i];
    outb[i] = h1[i] + acc;
}
