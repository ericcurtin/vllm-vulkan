#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
layout(push_constant) uniform P { uint n; uint top_k; };
layout(binding = 0) readonly  buffer DOWNS { float downs[]; }; // [top_k*n], expert k at k*n
layout(binding = 1) readonly  buffer W     { float w[]; };     // [top_k]
layout(binding = 2) writeonly buffer OUTB  { float routed[]; };// [n]
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= n) return;
    float acc = 0.0;
    for (uint k = 0u; k < top_k; ++k) acc += w[k] * downs[k * n + i];
    routed[i] = acc;
}
